generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  SHOP
  EDUCATION
  CONSULTING
}

enum PlanTier {
  STARTER
  BUSINESS
  PRO
}

enum UserRole {
  OWNER
  EMPLOYEE
}

enum LookupKind {
  ORDER
  ACCESS
}

enum FormFieldType {
  TEXT
  NUMBER
  PHONE
  SINGLE_CHOICE
  MULTI_CHOICE
  FILE
}

enum BroadcastStatus {
  DRAFT
  QUEUED
  SENDING
  DONE
  FAILED
}

enum LessonStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Platform operator accounts (Telebino staff) — fully separate from the
/// business-scoped User model, with its own email/password login and JWT.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Business {
  id        String       @id @default(cuid())
  name      String
  type      BusinessType
  planTier  PlanTier     @default(STARTER)
  /// Dev-only placeholder for real billing status (set true by the manual
  /// plan-switch endpoint). Gates bot replies past the 5 free trial messages.
  isSubscriptionActive Boolean @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users               User[]
  products            Product[]
  faqEntries          FaqEntry[]
  lookupEntries       LookupEntry[]
  customers           Customer[]
  forms               FormDef[]
  bots                Bot[]
  broadcasts          Broadcast[]
  unansweredQuestions UnansweredQuestion[]
  courseAccess        CourseAccess[]
}

model User {
  id         String   @id @default(cuid())
  phone      String   @unique
  role       UserRole @default(OWNER)
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int?
  imageUrl    String?
  /// Business-type-specific extras (stock/category for shops, grade/subject/accessType for education, duration for consulting)
  attributes  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lookupEntries LookupEntry[]
  courseLessons CourseLesson[]
  courseAccess  CourseAccess[]

  @@index([businessId])
}

/// One video lesson within a course product. A "course" is just a regular
/// Product (sold through the same order/lookup flow as any other product) that
/// happens to have lessons attached — no separate course sales pipeline.
model CourseLesson {
  id              String       @id @default(cuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  title           String
  order           Int          @default(0)
  /// Null until the upload finishes processing on ArvanCloud.
  arvanVideoId    String?
  status          LessonStatus @default(PENDING)
  durationSeconds Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([productId])
}

/// Granted once a course order is manually confirmed as paid in the panel
/// (see LookupEntry). Checked directly by Telegram identity — the student
/// never needs to type in an access code for a course they bought via the bot.
model CourseAccess {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  telegramUserId String
  grantedAt      DateTime @default(now())

  @@unique([businessId, productId, telegramUserId])
  @@index([businessId, telegramUserId])
}

model FaqEntry {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  question          String
  alternatePhrases  String[]
  answer            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([businessId])
}

model LookupEntry {
  id            String     @id @default(cuid())
  businessId    String
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind          LookupKind
  identifier    String
  status        String
  customerPhone String?
  /// Set by the bot when it creates the order — lets "mark as paid" grant
  /// CourseAccess by Telegram identity even if the customer never shared a phone.
  customerTelegramUserId String?
  note          String?
  notifyOnUpdate Boolean   @default(true)
  productId     String?
  /// Kept even if the product is later deleted — the order/access record itself is historical.
  product       Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([businessId, kind, identifier])
  @@index([businessId, kind])
  @@index([productId])
}

model Customer {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  telegramUserId String
  telegramUsername String?
  phone          String?
  messageCount   Int      @default(0)
  blocked        Boolean  @default(false)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  formSubmissions FormSubmission[]

  @@unique([businessId, telegramUserId])
  @@index([businessId])
}

model FormDef {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  fields      FormField[]
  submissions FormSubmission[]

  @@index([businessId])
}

model FormField {
  id       String        @id @default(cuid())
  formId   String
  form     FormDef       @relation(fields: [formId], references: [id], onDelete: Cascade)
  label    String
  type     FormFieldType
  required Boolean       @default(true)
  options  String[]
  order    Int           @default(0)

  @@index([formId])
}

model FormSubmission {
  id         String   @id @default(cuid())
  formId     String
  form       FormDef  @relation(fields: [formId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  answers    Json
  createdAt  DateTime @default(now())

  @@index([formId])
}

model Bot {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  token         String
  telegramBotId String
  username      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId])
}

model Broadcast {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  text       String
  mediaUrl   String?
  status     BroadcastStatus @default(DRAFT)
  sentCount  Int             @default(0)
  failCount  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([businessId])
}

model UnansweredQuestion {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  question   String
  askedAt    DateTime @default(now())

  @@index([businessId])
}
